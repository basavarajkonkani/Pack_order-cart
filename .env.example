# Firebase project config — copy this file to .env and fill in your values
# from Firebase Console → Project Settings → General → Your apps → SDK setup and configuration.
# Vars must be prefixed with EXPO_PUBLIC_ so Expo exposes them to the app bundle.
# These are public client identifiers, not secrets — access is enforced by Firestore Security Rules.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# App Check (web builds only) — reCAPTCHA v3 site key from
# Firebase Console → App Check → register the web app.
# Optional: if left blank, App Check is skipped and the app still runs.
# Native iOS/Android is not covered by this; see lib/firebase.ts.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
