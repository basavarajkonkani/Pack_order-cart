# Firebase project config — copy this file to .env and fill in your values.
# This MUST point to the SAME Firebase project used by the Buyer App
# (Shop-Cart-Flow/.env) so data stays in sync.
# Vars must be prefixed with VITE_ so Vite exposes them to the client bundle.
# These are public client identifiers, not secrets — access is enforced by
# Firestore/Storage Security Rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — reCAPTCHA v3 site key from
# Firebase Console → App Check → register this web app.
# Optional: if left blank, App Check is skipped and the portal still runs,
# but a production build will log a warning.
VITE_RECAPTCHA_SITE_KEY=
